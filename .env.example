# Supabase > Project Settings > API. Usadas no navegador e no servidor.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-OU-PUBLISHABLE
# Nunca use service_role/secret key nas variáveis NEXT_PUBLIC_.
# NewsAPI: somente servidor; opcional. Em produção, use um plano compatível.
NEWS_API_KEY=
# Origem canônica para redirects Auth; configure também na Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
